# Flask Configuration
# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# MariaDB (DB_ROOT_PASSWORD, DB_PASSWORD and ADMIN_PASSWORD are required)
DB_ROOT_PASSWORD=change-this-root-password
DB_NAME=zitatdatenbank
DB_USER=zitate
DB_PASSWORD=change-this-db-password

# Web port (host:container)
WEB_PORT=5000

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Session cookies are Secure-only (HTTPS, or http://localhost). Set to false to
# use the app over plain HTTP from other machines on a trusted network.
# SESSION_COOKIE_SECURE=true
